datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  userId          String           @default("anonymous_owner")
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  versions        ProjectVersion[]
  generationRuns  GenerationRun[]
  usageLedger     AiUsageLedger[]
  qualityReports  QualityReport[]
  auditEvents     AuditEvent[]
}

model ProjectVersion {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId       String   @db.ObjectId
  versionNumber   Int
  businessProfile Json
  sitePlan        Json
  designSystem    Json
  manifest        Json
  contentBlocks   Json
  createdAt       DateTime @default(now())

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, versionNumber])
}

model GenerationRun {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId         String    @db.ObjectId
  status            String    // running, completed, failed_recoverable
  currentStage      String    // 12 discrete stages
  inputSnapshotHash String
  aiCallCount       Int       @default(0)
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  estimatedCostINR  Float     @default(0.0)
  qualityStatus     String    @default("pending")
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AiUsageLedger {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId        String   @db.ObjectId
  runId            String?
  stage            String
  model            String
  inputTokens      Int
  outputTokens     Int
  estimatedCostINR Float
  durationMs       Int
  promptVersion    String
  createdAt        DateTime @default(now())

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model QualityReport {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId       String   @db.ObjectId
  runId           String?
  overallStatus   String   // pass, block, warn
  structuralCheck Json
  functionalCheck Json
  responsiveCheck Json
  contentCheck    Json
  a11yCheck       Json
  similarityScore Float
  remediationRun  Boolean  @default(false)
  createdAt       DateTime @default(now())

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
